# Optional. Local dev already defaults to http://localhost:8000 and
# production already defaults to relative paths (same-origin, via the
# Vercel Services rewrites in vercel.json) -- only set this if your backend
# runs somewhere other than either of those defaults.
# VITE_API_BASE_URL=http://localhost:8000

# Supabase project URL and anon/publishable key, from the Supabase
# dashboard (Project Settings -> API) or the Vercel project's already-
# provisioned SUPABASE_URL / SUPABASE_ANON_KEY env vars.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

{
  "buildCommand": "npm install --prefix frontend && npm run build --prefix frontend",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm install && npm run build"
    },
    "backend": {
      "root": "backend",
      "runtime": "python@3.12",
      "entrypoint": "api/index.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "backend"
    }
  ]
}

{
  "env": {
    "OPENAI_MODEL": "gpt-4o-mini",
    "CORS_ORIGINS": "http://localhost:5173"
  },
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm install",
      "buildCommand": "npm run build"
    },
    "backend": {
      "root": "backend",
      "runtime": "python",
      "entrypoint": "app.main:app",
      "installCommand": "python -m pip install -r requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}

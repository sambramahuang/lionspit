{
  "buildCommand": "npm install --prefix frontend && npm run build --prefix frontend",
  "env": {
    "OPENAI_MODEL": "gpt-4o-mini"
  },
  "envs": {
    "production": {
      "CORS_ORIGINS": "@CORS_ORIGINS_PROD"
    },
    "preview": {
      "CORS_ORIGINS": "@CORS_ORIGINS_PREVIEW"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/dist/$1"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    }
  ]
}

# Copy this file to .env and add your real key locally.
# This file is safe to commit; do not put real secrets here.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CORS_ORIGINS=http://localhost:5173

# Supabase Postgres connection string (use the "Transaction pooler" mode --
# correct for serverless/Vercel, also fine for local dev). Find it under
# Project Settings -> Database -> Connection string in the Supabase dashboard.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@your-pooler-host:6543/postgres

# Supabase project URL and anon/public key -- Project Settings -> API.
# Same values the frontend uses (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY).
# Used to verify login sessions via Supabase's own Auth API; required for
# every request except /api/health.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Comma-separated, case-insensitive. A logged-in user is a "partner" iff
# their verified email is in this list -- no DB table, no admin UI.
PARTNER_EMAILS=you@yourfirm.com
